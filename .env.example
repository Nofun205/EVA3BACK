# ==============================================================================
# BUILDCORP - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================

# Entorno: Development / Production
DEBUG=True
SECRET_KEY=django-insecure-buildcorp-secret-key-evaluacion-3-inacap-2026

# Hosts permitidos (separados por coma). En producción incluir IP Pública de EC2 y DNS
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*

# ------------------------------------------------------------------------------
# CONFIGURACIÓN BASE DE DATOS (PostgreSQL para EC2 / Local)
# ------------------------------------------------------------------------------
# Opción 1: Mediante URL completa (Recomendado)
DATABASE_URL=postgresql://buildcorp_user:buildcorp_pass_2026@localhost:5432/buildcorp_db

# Opción 2: Parámetros individuales
DB_ENGINE=postgresql
DB_NAME=buildcorp_db
DB_USER=buildcorp_user
DB_PASSWORD=buildcorp_pass_2026
DB_HOST=localhost
DB_PORT=5432

# Modo fallback a SQLite para desarrollo sin PostgreSQL local si es necesario (True/False)
USE_SQLITE_FALLBACK=True

# Configuración de CORS
CORS_ALLOW_ALL_ORIGINS=True
